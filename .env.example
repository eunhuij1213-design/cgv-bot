# 디스코드 웹훅 URL (필수)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# 선택 설정
# LOOKAHEAD_DAYS=30          # 오늘부터 며칠 뒤까지의 금/토/일을 감시할지
# SCREEN_KEYWORD=IMAX        # 상영관 필터. 빈 값이면 극장의 모든 상영관
# STATE_PATH=state.json      # 상태 파일 경로
# 알림에 걸리는 바로가기 링크. {scn_ymd} {site_no} {mov_no} 치환 가능
# BOOKING_URL=https://cgv.co.kr/
# REQUEST_DELAY=0.7          # 날짜별 API 요청 간격(초)
# NOTIFY_ON_FIRST_RUN=false  # 상태 파일이 없는 첫 실행에도 오픈 알림을 보낼지
